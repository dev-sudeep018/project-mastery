  "references": [
    {
      "key": "rouge",
      "title": "Lin, ROUGE: A Package for Automatic Evaluation of Summaries",
      "url": "https://aclanthology.org/W04-1013/",
      "lessons": ["e26"],
      "scope": "Single-reference token LCS F1; no stemming or sentence aggregation."
    },
    {
      "key": "bleu",
      "title": "Papineni et al., BLEU: a Method for Automatic Evaluation of Machine Translation",
      "url": "https://aclanthology.org/P02-1040/",
      "lessons": ["e27"],
      "scope": "One-reference sentence BLEU-1 with clipping and brevity penalty; no corpus or multi-order claim."
    },
    {
      "key": "ks",
      "title": "SciPy two-sample Kolmogorov-Smirnov documentation",
      "url": "https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.ks_2samp.html",
      "lessons": ["e35"],
      "scope": "Descriptive two-sided empirical-CDF distance only; deterministic earliest maximizer and no p-value."
    },
    {
      "key": "conformal",
      "title": "Angelopoulos and Bates, A Gentle Introduction to Conformal Prediction",
      "url": "https://arxiv.org/abs/2107.07511",
      "lessons": ["e36", "e37"],
      "scope": "Absolute-residual split-conformal intervals and descriptive coverage; finite rank required and exchangeability assumption stated."
    },
    {
      "key": "binomial",
      "title": "SciPy exact binomial test documentation",
      "url": "https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.binomtest.html",
      "lessons": ["e38"],
      "scope": "Fair-sign null with ties excluded; exact doubled smaller tail for p=0.5."
    },
    {
      "key": "pr",
      "title": "scikit-learn precision-recall curve documentation",
      "url": "https://scikit-learn.org/stable/modules/generated/sklearn.metrics.precision_recall_curve.html",
      "lessons": ["e41"],
      "scope": "Only observed descending-score thresholds; no synthetic endpoint or area aggregation."
    },
    {
      "key": "paged",
      "title": "Kwon et al., Efficient Memory Management for Large Language Model Serving with PagedAttention",
      "url": "https://arxiv.org/abs/2309.06180",
      "lessons": ["e46"],
      "scope": "Logical page-table gathering only; no GPU kernel, memory allocator, or throughput claim."
    },
    {
      "key": "speculative",
      "title": "Leviathan et al., Fast Inference from Transformers via Speculative Decoding",
      "url": "https://proceedings.mlr.press/v202/leviathan23a.html",
      "lessons": ["e48"],
      "scope": "Supplied draft-prefix verification and normalized residual distribution; no bonus-token generation or model serving."
    },
    {
      "key": "amp",
      "title": "PyTorch Automatic Mixed Precision examples",
      "url": "https://docs.pytorch.org/docs/2.14/notes/amp_examples.html",
      "lessons": ["e49", "e50"],
      "scope": "Sample-weighted supplied gradients and finite-check/unscale gate; no autograd or optimizer implementation."
    },
    {
      "key": "reservoir",
      "title": "Vitter, Random Sampling with a Reservoir",
      "url": "https://www.cs.usfca.edu/~mmalensek/cs677/schedule/papers/vitter1985random.pdf",
      "lessons": ["e51"],
      "scope": "Basic reservoir replacement with supplied integer draws; not Algorithm Z or a random-number generator."
    },
    {
      "key": "welford",
      "title": "Welford, Note on a Method for Calculating Corrected Sums of Squares and Products",
      "url": "https://www.tandfonline.com/doi/abs/10.1080/00401706.1962.10490022",
      "lessons": ["e52"],
      "scope": "Streaming count, mean, and unnormalized centered sum of squares."
    },
    {
      "key": "variance",
      "title": "Chan, Golub, and LeVeque, Algorithms for Computing the Sample Variance",
      "url": "https://www.tandfonline.com/doi/abs/10.1080/00031305.1983.10483115",
      "lessons": ["e53"],
      "scope": "Pairwise moment merging with a between-partition correction; no raw-data reconstruction."
    },
    {
      "key": "weighted",
      "title": "Efraimidis, Weighted Random Sampling over Data Streams",
      "url": "https://arxiv.org/abs/1012.0256",
      "lessons": ["e54"],
      "scope": "Logarithmic priority equivalent of exponential keys, supplied draws, sampling without replacement."
    },
    {
      "key": "hashing",
      "title": "scikit-learn FeatureHasher documentation",
      "url": "https://scikit-learn.org/stable/modules/generated/sklearn.feature_extraction.FeatureHasher.html",
      "lessons": ["e55"],
      "scope": "Concept of signed feature hashing; the lesson uses its own explicit polynomial teaching hash, not MurmurHash or sklearn parity."
    },
    {
      "key": "countmin",
      "title": "Cormode and Muthukrishnan, An Improved Data Stream Summary: The Count-Min Sketch and Its Applications",
      "url": "https://www.cs.ox.ac.uk/people/graham.cormode/pubs/html/CormodeMuthukrishnan04CMJalg.html",
      "lessons": ["e56"],
      "scope": "Ordinary nonnegative counter updates with supplied hash buckets; no conservative updates or claimed error bound."
    },
    {
      "key": "bloom",
      "title": "Bloom, Space/Time Trade-offs in Hash Coding with Allowable Errors",
      "url": "https://www.cs.princeton.edu/courses/archive/spr05/cos598E/bib/p422-bloom.pdf",
      "lessons": ["e57"],
      "scope": "Boolean membership bits with supplied hashes; no deletion and no claimed false-positive rate."
    },
    {
      "key": "asof",
      "title": "pandas merge_asof documentation",
      "url": "https://pandas.pydata.org/docs/reference/api/pandas.merge_asof.html",
      "lessons": ["e62"],
      "scope": "Backward, exact-match-allowed single-clock join with stable last-row timestamp ties; no nearest/forward modes."
    }
  ],
