{
  "name": "project-mastery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "tsx scripts/prepare.ts",
    "dev": "pnpm setup && node scripts/dev.mjs",
    "build": "pnpm setup && pnpm --filter @mastery/web build",
    "preview": "node scripts/serve.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @mastery/web typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:python": "python -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm setup && pnpm validate:content && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:python && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "esbuild": "0.27.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "pyodide": "314.0.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.0.5",
    "yaml": "2.8.1"
  }
}
